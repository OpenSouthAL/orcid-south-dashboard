{
	"name": "orcid-south-dashboard",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:22",
	"postCreateCommand": "npm ci",
	"forwardPorts": [5173, 8788],
	"portsAttributes": {
		"5173": { "label": "Vite dev", "onAutoForward": "openPreview" },
		"8788": { "label": "Wrangler Pages dev" }
	},
	"customizations": {
		"vscode": {
			"extensions": ["svelte.svelte-vscode"]
		}
	}
}
